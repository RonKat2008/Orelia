DATABASE_URL=
ANTHROPIC_API_KEY=
EXA_API_KEY=
NCBI_API_KEY=
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
AGENTCALL_API_KEY=
AGENTCALL_WEBHOOK_SECRET=
# AgentCall number id (num_...), not a phone number. See docs/integrations/agentcall.md
AGENTCALL_FROM_NUMBER_ID=
# Phone provider: vapi | agentcall. Unset = Vapi when VAPI_API_KEY and VAPI_PHONE_NUMBER_ID are set, else AgentCall.
# See docs/VOICE-PROVIDER.md.
VOICE_PROVIDER=
# Vapi private API key (dashboard.vapi.ai -> API Keys). Server-side only.
VAPI_API_KEY=
# Vapi phone number id (a Vapi number or an imported Twilio number), not the phone number itself.
VAPI_PHONE_NUMBER_ID=
# Long random value. Wayfinder sends it to Vapi on each call (assistant.server.headers x-vapi-secret) and the
# /api/webhooks/vapi route refuses any request without it.
VAPI_WEBHOOK_SECRET=
# Optional: webhook URL override. Default: $WAYFINDER_APP_BASE_URL (or $WAYFINDER_APP_ORIGIN) + /api/webhooks/vapi (https only).
VAPI_SERVER_URL=
# Set by Vercel automatically (production host, no scheme); last fallback for the Vapi webhook URL. Leave unset locally.
VERCEL_PROJECT_PRODUCTION_URL=
# Leave unset during development/demo; real (non-allowlisted) sends stay blocked.
OUTBOUND_ALLOW_REAL=
OUTBOUND_ALLOWLIST=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local Inngest dev server flag (1 allows workflow events without INNGEST_EVENT_KEY). Never in production.
INNGEST_DEV=
# Shared secret for the Vercel Cron follow-up sweep (/api/cron/follow-ups) used when Inngest is not configured.
# Vercel sends it as `Authorization: Bearer $CRON_SECRET`. Generate a long random value; never commit it.
CRON_SECRET=
WAYFINDER_OFFLINE=
# Client-side mirror of WAYFINDER_OFFLINE: shows the labelled sample shortlist when the API is unreachable.
NEXT_PUBLIC_WAYFINDER_OFFLINE=
WAYFINDER_DEMO=
# --- Demo / simulation / AI gateway (added by safety review L2) ---
# Simulated-time multiplier for follow-up cadence in the demo (e.g. 86400 = one business day per second).
WAYFINDER_SIM_TIME_SCALE=
# Set to 1 to record live LLM calls as fixtures (fixtures/llm); never in CI or the demo.
WAYFINDER_RECORD_LLM=
# Comma-separated test inboxes scripted demo coordinators may reply to (falls back to OUTBOUND_ALLOWLIST).
DEMO_REPLY_ALLOWLIST=
# Optional: send all cases from this one existing AgentMail inbox (e.g. me@agentmail.to) instead of one inbox per case.
AGENTMAIL_SENDER_INBOX_ID=
# Optional: verified domain for per-agent inboxes (each ResourceAgent gets its own inbox; default agentmail.to).
AGENTMAIL_INBOX_DOMAIN=
# Optional: resource-agent run lease in ms (default 90000, minimum 5000); stops overlapping runs from double-acting.
AGENT_LEASE_MS=
# DEMO ONLY. 1 routes every selected resource to our own allowlisted AgentMail test inboxes ("Demo coordinator").
WAYFINDER_DEMO_COORDINATORS=
# Comma-separated demo coordinator inboxes (must also be on OUTBOUND_ALLOWLIST). Default: allowlisted emails minus the sender inbox.
DEMO_COORDINATOR_INBOXES=
# Path of the demo state file written by seed-demo (defaults to a local dev file).
WAYFINDER_DEMO_STATE=
# Neon AI Gateway endpoint and token (optional LLM routing).
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=

# Neon AI Gateway (both required to enable gateway routing)
# Optional per-role model overrides
WAYFINDER_MODEL_ORCHESTRATOR=
WAYFINDER_MODEL_INTAKE=
WAYFINDER_MODEL_VERIFIER=
WAYFINDER_MODEL_INBOX=
WAYFINDER_MODEL_CURATOR=
WAYFINDER_MODEL_RESEARCH=
WAYFINDER_MODEL_FORM=
WAYFINDER_MODEL_EMBEDDING=

# Set to 1 to enable the opt-in live-run test (tests/live/live-run.test.ts); see docs/LIVE-RUN.md.
WAYFINDER_LIVE=
# HMAC key for the wf_session cookie (anonymous per-browser case ownership). Required in production.
# Generate with: openssl rand -base64 32
WAYFINDER_SESSION_SECRET=
# Optional: HMAC key for medical-history share links (defaults to a key derived from WAYFINDER_SESSION_SECRET).
WAYFINDER_SHARE_SECRET=
# Optional exact origin of the deployed app (e.g. https://wayfinder.example.com) used for the CSRF Origin check.
# When unset, the request URL / x-forwarded-host origin is used.
WAYFINDER_APP_ORIGIN=

# Per-case LLM spend cap in USD (lib/ai/usage.ts); calls beyond it are refused. Unset uses the built-in default.
WAYFINDER_CASE_BUDGET_USD=

# HMAC secret for expiring patient approval links. Required before a notice can be sent.
WAYFINDER_NOTIFY_LINK_SECRET=
# Public origin used in approval links (no trailing path).
WAYFINDER_APP_BASE_URL=
# HMAC secret for doctor consultation review links (lib/coordination/consult/token.ts). Unset derives one from WAYFINDER_SESSION_SECRET.
WAYFINDER_REVIEW_LINK_SECRET=
# AgentMail inbox id that sends approval notices to the patient (system inbox, not a hospital).
WAYFINDER_NOTIFY_INBOX_ID=

# --- task #58 (web application channel) ---
# Kernel (onkernel.com) cloud-browser key used to fill online application forms. Empty = web channel reports 'unconfigured'.
KERNEL_API_KEY=
# Comma-separated hosts the web channel may open/submit to (e.g. localhost:3000,apply.example.org). Empty = none.
OUTBOUND_WEB_ALLOWLIST=

# Accounts (Neon Auth / Better Auth on the Neon project). Unset = anonymous-only (accounts UI hidden).
# NEON_AUTH_BASE_URL is the branch's Auth URL; the cookie secret must be at least 32 characters.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Optional true: enable configured accounts even when WAYFINDER_OFFLINE=1 keeps research on fixtures.
# false explicitly disables accounts. Unset keeps offline runs anonymous-only.
WAYFINDER_ACCOUNTS_ENABLED=
# Private Vercel Blob store for the medical-document library (never public URLs). Either a read-write token,
# or BLOB_STORE_ID with the platform's VERCEL_OIDC_TOKEN. Unset = in-memory files (dev/tests only).
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
# --- calendar (appointments, ICS feeds, Google Calendar) ---
# 32 random bytes, base64. Seals Google tokens (AES-256-GCM) and signs private calendar feed URLs. Required in production.
WAYFINDER_TOKEN_KEY=
# Google OAuth web client for Calendar sync (scope calendar.events; calendar.freebusy only on opt-in). Empty = Google shows as unavailable; ICS feeds still work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to <request origin>/api/integrations/google/callback.
GOOGLE_REDIRECT_URI=

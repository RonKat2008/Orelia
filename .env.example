DATABASE_URL=
ANTHROPIC_API_KEY=
EXA_API_KEY=
NCBI_API_KEY=
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
AGENTCALL_API_KEY=
AGENTCALL_WEBHOOK_SECRET=
# AgentCall number id (num_...), not a phone number. See docs/integrations/agentcall.md
AGENTCALL_FROM_NUMBER_ID=
# Leave unset during development/demo; real (non-allowlisted) sends stay blocked.
OUTBOUND_ALLOW_REAL=
OUTBOUND_ALLOWLIST=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 with the local Inngest dev server so approved contact plans emit plan/approved.
INNGEST_DEV=
WAYFINDER_OFFLINE=
WAYFINDER_DEMO=
# --- Demo / simulation / AI gateway (added by safety review L2) ---
# Simulated-time multiplier for follow-up cadence in the demo (e.g. 86400 = one business day per second).
WAYFINDER_SIM_TIME_SCALE=
# Set to 1 to record live LLM calls as fixtures (fixtures/llm); never in CI or the demo.
WAYFINDER_RECORD_LLM=
# Comma-separated test inboxes scripted demo coordinators may reply to (falls back to OUTBOUND_ALLOWLIST).
DEMO_REPLY_ALLOWLIST=
# Path of the demo state file written by seed-demo (defaults to a local dev file).
WAYFINDER_DEMO_STATE=
# Neon AI Gateway endpoint and token (optional LLM routing).
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=

# Neon AI Gateway (both required to enable gateway routing)
# Optional per-role model overrides
WAYFINDER_MODEL_ORCHESTRATOR=
WAYFINDER_MODEL_INTAKE=
WAYFINDER_MODEL_VERIFIER=
WAYFINDER_MODEL_INBOX=
WAYFINDER_MODEL_CURATOR=
WAYFINDER_MODEL_RESEARCH=
WAYFINDER_MODEL_EMBEDDING=

# Set to 1 to enable the opt-in live-run test (tests/live/live-run.test.ts); see docs/LIVE-RUN.md.
WAYFINDER_LIVE=
# HMAC key for the wf_session cookie (anonymous per-browser case ownership). Required in production.
# Generate with: openssl rand -base64 32
WAYFINDER_SESSION_SECRET=
# Optional exact origin of the deployed app (e.g. https://wayfinder.example.com) used for the CSRF Origin check.
# When unset, the request URL / x-forwarded-host origin is used.
WAYFINDER_APP_ORIGIN=

# Per-case LLM spend cap in USD (lib/ai/usage.ts); calls beyond it are refused. Unset uses the built-in default.
WAYFINDER_CASE_BUDGET_USD=

# HMAC secret for expiring patient approval links. Required before a notice can be sent.
WAYFINDER_NOTIFY_LINK_SECRET=
# Public origin used in approval links (no trailing path).
WAYFINDER_APP_BASE_URL=
# AgentMail inbox id that sends approval notices to the patient (system inbox, not a hospital).
WAYFINDER_NOTIFY_INBOX_ID=


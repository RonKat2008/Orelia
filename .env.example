DATABASE_URL=
ANTHROPIC_API_KEY=
EXA_API_KEY=
NCBI_API_KEY=
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
AGENTCALL_API_KEY=
AGENTCALL_WEBHOOK_SECRET=
# AgentCall number id (num_...), not a phone number. See docs/integrations/agentcall.md
AGENTCALL_FROM_NUMBER_ID=
# Leave unset during development/demo; real (non-allowlisted) sends stay blocked.
OUTBOUND_ALLOW_REAL=
OUTBOUND_ALLOWLIST=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
WAYFINDER_OFFLINE=
WAYFINDER_DEMO=

# Neon AI Gateway (both required to enable gateway routing)
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
# Optional per-role model overrides
WAYFINDER_MODEL_ORCHESTRATOR=
WAYFINDER_MODEL_INTAKE=
WAYFINDER_MODEL_VERIFIER=
WAYFINDER_MODEL_INBOX=
WAYFINDER_MODEL_CURATOR=
WAYFINDER_MODEL_RESEARCH=
WAYFINDER_MODEL_EMBEDDING=
# HMAC key for the wf_session cookie (anonymous per-browser case ownership). Required in production.
# Generate with: openssl rand -base64 32
WAYFINDER_SESSION_SECRET=
# Optional exact origin of the deployed app (e.g. https://wayfinder.example.com) used for the CSRF Origin check.
# When unset, the request URL / x-forwarded-host origin is used.
WAYFINDER_APP_ORIGIN=
